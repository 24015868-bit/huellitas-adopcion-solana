# Copia este archivo como .env (el .env NO se sube a GitHub). Ninguna variable es una llave privada:
# el agente es de SOLO LECTURA y no necesita wallet.

# RPC de Solana (Devnet por defecto)
RPC_URL=https://api.devnet.solana.com

# Servidor local de LM Studio (Developer -> Start Server). Puerto por defecto: 1234
LM_STUDIO_URL=http://localhost:1234/v1

# Nombre del modelo cargado en LM Studio. Si lo dejas vacio se usa el primero que reporte el servidor.
# Debe ser un modelo con capacidad "Tool use".
MODEL_NAME=

# Opcional: Program ID distinto al del IDL (por ejemplo si desplegaste otro programa)
# PROGRAM_ID=
