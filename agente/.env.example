# Copia este archivo como .env (el .env real NO se sube a GitHub).
# Ninguna variable es una llave privada de Solana: el agente es de SOLO LECTURA.

# RPC de Solana (Devnet)
RPC_URL=https://api.devnet.solana.com

# Direccion PUBLICA de la autoridad que creo el refugio (la wallet con la que usas la app).
# No es el Program ID ni la direccion del refugio: con ella se deriva la PDA ["refugio", OWNER].
OWNER=REEMPLAZA_CON_LA_DIRECCION_PUBLICA_DE_LA_AUTORIDAD

# Servidor del modelo (LM Studio: Developer -> Start Server, puerto 1234 por defecto)
LLM_BASE_URL=http://localhost:1234/v1
# Identificador del modelo realmente cargado en LM Studio (debe soportar "Tool use")
LLM_MODEL=REEMPLAZA_CON_EL_IDENTIFICADOR_DEL_MODELO_CARGADO
# Valor fijo para LM Studio local, o la credencial de tu proveedor si usas una API remota (es un secreto)
LLM_API_KEY=lm-studio

# Opcional: Program ID distinto al que trae el IDL (frontend/src/idl/adopcion.json)
# PROGRAM_ID=
